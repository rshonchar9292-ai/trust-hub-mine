-- ModuleScript: ReplicatedStorage/ModMenu/ui
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = {}
local C = {
	bg = Color3.fromRGB(13, 15, 22),
	side = Color3.fromRGB(20, 23, 32),
	card = Color3.fromRGB(27, 31, 43),
	line = Color3.fromRGB(46, 51, 67),
	purple = Color3.fromRGB(139, 112, 255),
	purpleDark = Color3.fromRGB(53, 45, 91),
	text = Color3.fromRGB(243, 243, 250),
	muted = Color3.fromRGB(151, 157, 176),
	green = Color3.fromRGB(105, 225, 166),
}

local function corner(object, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = object
end

local function makeLabel(parent, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or C.text
	label.TextSize = size
	label.Font = font or Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

local function newButton(parent, text, size, position, color)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = C.text
	button.TextSize = 12
	button.Font = Enum.Font.GothamSemibold
	button.AutoButtonColor = false
	button.Parent = parent
	corner(button, 9)
	return button
end

function UI.Start(features)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("ModMenuUI")
	if old then old:Destroy() end

	local gui = Instance.new("ScreenGui")
	gui.Name = "ModMenuUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local shell = Instance.new("Frame")
	shell.Name = "Window"
	shell.AnchorPoint = Vector2.new(0.5, 0.5)
	shell.Position = UDim2.fromScale(0.5, 0.5)
	shell.Size = UDim2.fromOffset(760, 490)
	shell.BackgroundColor3 = C.bg
	shell.BorderSizePixel = 0
	shell.Visible = false
	shell.Parent = gui
	corner(shell, 16)
	local outline = Instance.new("UIStroke")
	outline.Color = C.line
	outline.Transparency = 0.15
	outline.Parent = shell
	local scale = Instance.new("UIScale")
	scale.Scale = 0.94
	scale.Parent = shell

	local sidebar = Instance.new("Frame")
	sidebar.Size = UDim2.new(0, 205, 1, 0)
	sidebar.BackgroundColor3 = C.side
	sidebar.BorderSizePixel = 0
	sidebar.Parent = shell
	corner(sidebar, 16)
	local mask = Instance.new("Frame")
	mask.Position = UDim2.new(1, -16, 0, 0)
	mask.Size = UDim2.new(0, 16, 1, 0)
	mask.BackgroundColor3 = C.side
	mask.BorderSizePixel = 0
	mask.Parent = sidebar

	local brand = makeLabel(sidebar, "NOVA", 22, C.text, Enum.Font.GothamBold)
	brand.Position = UDim2.fromOffset(22, 23)
	brand.Size = UDim2.new(1, -40, 0, 28)
	local caption = makeLabel(sidebar, "GAME TOOLKIT", 9, C.muted, Enum.Font.GothamBold)
	caption.Position = UDim2.fromOffset(23, 52)
	caption.Size = UDim2.new(1, -40, 0, 16)
	local divider = Instance.new("Frame")
	divider.Position = UDim2.fromOffset(20, 82)
	divider.Size = UDim2.new(1, -40, 0, 1)
	divider.BackgroundColor3 = C.line
	divider.BorderSizePixel = 0
	divider.Parent = sidebar

	local nav = Instance.new("Frame")
	nav.Position = UDim2.fromOffset(12, 105)
	nav.Size = UDim2.new(1, -24, 0, 150)
	nav.BackgroundTransparency = 1
	nav.Parent = sidebar
	local navLayout = Instance.new("UIListLayout")
	navLayout.Padding = UDim.new(0, 8)
	navLayout.Parent = nav

	local content = Instance.new("Frame")
	content.Position = UDim2.fromOffset(205, 0)
	content.Size = UDim2.new(1, -205, 1, 0)
	content.BackgroundTransparency = 1
	content.Parent = shell

	local pageTitle = makeLabel(content, "Combat", 23, C.text, Enum.Font.GothamBold)
	pageTitle.Position = UDim2.fromOffset(28, 20)
	pageTitle.Size = UDim2.new(1, -90, 0, 28)
	local subtitle = makeLabel(content, "Game tools and visual preferences", 11, C.muted)
	subtitle.Position = UDim2.fromOffset(29, 49)
	subtitle.Size = UDim2.new(1, -60, 0, 18)
	local close = newButton(content, "×", UDim2.fromOffset(34, 34), UDim2.new(1, -52, 0, 20), C.card)
	close.TextSize = 22

	local pageBody = Instance.new("Frame")
	pageBody.Position = UDim2.fromOffset(28, 91)
	pageBody.Size = UDim2.new(1, -56, 1, -118)
	pageBody.BackgroundTransparency = 1
	pageBody.Parent = content

	local activeTab = "Combat"
	local isOpen = false
	local busy = false
	local navButtons = {}

	local function setOpen(value)
		if busy or isOpen == value then return end
		busy = true
		isOpen = value
		if value then
			shell.Visible = true
			scale.Scale = 0.94
			shell.Position = UDim2.fromScale(0.5, 0.52)
			TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
			local tween = TweenService:Create(shell, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.fromScale(0.5, 0.5)})
			tween:Play()
			tween.Completed:Once(function() busy = false end)
		else
			local tween = TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.94})
			tween:Play()
			tween.Completed:Once(function()
				shell.Visible = false
				busy = false
			end)
		end
	end

	local function clearBody()
		for _, child in ipairs(pageBody:GetChildren()) do child:Destroy() end
	end

	local function addInfoCard(titleText, detailText)
		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, 0, 0, 72)
		card.BackgroundColor3 = C.card
		card.BorderSizePixel = 0
		card.Parent = pageBody
		corner(card, 11)
		local title = makeLabel(card, titleText, 13, C.text, Enum.Font.GothamSemibold)
		title.Position = UDim2.fromOffset(15, 10)
		title.Size = UDim2.new(1, -30, 0, 22)
		local detail = makeLabel(card, detailText, 10, C.muted)
		detail.Position = UDim2.fromOffset(15, 35)
		detail.Size = UDim2.new(1, -30, 0, 20)
	end

	local function addEspToggle()
		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, 0, 0, 72)
		card.BackgroundColor3 = C.card
		card.BorderSizePixel = 0
		card.Parent = pageBody
		corner(card, 11)
		local title = makeLabel(card, "Target marker", 13, C.text, Enum.Font.GothamSemibold)
		title.Position = UDim2.fromOffset(15, 10)
		title.Size = UDim2.new(1, -80, 0, 22)
		local detail = makeLabel(card, "Visual label for a target selected by your game", 10, C.muted)
		detail.Position = UDim2.fromOffset(15, 35)
		detail.Size = UDim2.new(1, -80, 0, 20)

		local toggle = newButton(card, "", UDim2.fromOffset(42, 24), UDim2.new(1, -58, 0.5, -12), Color3.fromRGB(55, 59, 73))
		local knob = Instance.new("Frame")
		knob.Size = UDim2.fromOffset(18, 18)
		knob.Position = UDim2.fromOffset(3, 3)
		knob.BackgroundColor3 = C.text
		knob.BorderSizePixel = 0
		knob.Parent = toggle
		corner(knob, 9)
		local on = false
		toggle.Activated:Connect(function()
			on = not on
			TweenService:Create(toggle, TweenInfo.new(0.15), {BackgroundColor3 = on and C.purple or Color3.fromRGB(55, 59, 73)}):Play()
			TweenService:Create(knob, TweenInfo.new(0.15), {Position = on and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)}):Play()
			if features and features.TargetESP then features.TargetESP.SetEnabled(on) end
		end)
	end

	local function showPage(name)
		activeTab = name
		pageTitle.Text = name
		clearBody()
		if name == "Visuals" then
			addEspToggle()
			addInfoCard("Choose target in your game", "Call TargetESP.SetTarget(model) from your own game logic.")
		elseif name == "Combat" then
			addInfoCard("Combat tools", "Add your game's server-validated tools here.")
		else
			addInfoCard("Movement tools", "Add movement options designed for your game here.")
		end
		for tab, button in pairs(navButtons) do
			local selected = tab == name
			button.BackgroundColor3 = selected and C.purpleDark or C.side
			button.TextColor3 = selected and C.text or C.muted
		end
	end

	for _, name in ipairs({"Combat", "Movement", "Visuals"}) do
		local button = newButton(nav, name, UDim2.new(1, 0, 0, 40), UDim2.new(), C.side)
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Text = "     " .. name
		navButtons[name] = button
		button.Activated:Connect(function() showPage(name) end)
	end

	local status = makeLabel(sidebar, "●  READY", 9, C.green, Enum.Font.GothamBold)
	status.Position = UDim2.new(0, 22, 1, -34)
	status.Size = UDim2.new(1, -40, 0, 18)
	close.Activated:Connect(function() setOpen(false) end)
	showPage(activeTab)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F4 then setOpen(not isOpen) end
	end)

	return {SetOpen = setOpen}
end

return UI
