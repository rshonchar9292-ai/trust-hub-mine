-- ModuleScript: ReplicatedStorage/ModMenu/loader
-- Call Loader.Start() once from a LocalScript in StarterPlayerScripts.
local Loader = {}
local started = false

function Loader.Start()
	if started then return end
	started = true

	local root = script.Parent
	local UI = require(root:WaitForChild("ui"))
	local featureFolder = root:WaitForChild("features")
	local ESP = require(featureFolder:WaitForChild("esp"))

	UI.Start({
		TargetESP = ESP,
	})
end

return Loader
